# =======================================================================
# CityGuards — Ficheiro de Configuração Exemplo (.env.example)
#
# Copie este ficheiro para '.env.local' (no Next.js) e '.env' (nas funções)
# e preencha com as suas chaves e endpoints reais.
# =======================================================================

# ── 1. Persistência de Dados (Google Cloud Firestore Admin SDK) ────────
# O ID do projeto Firebase
FIREBASE_PROJECT_ID=cityguards-xxxx

# O email da conta de serviço gerada no portal da Google Cloud Console
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@cityguards-xxxx.iam.gserviceaccount.com

# A chave privada gerada no portal do Firebase (lembre-se de manter os \n para formatação correta)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDh...\n-----END PRIVATE KEY-----\n"


# ── 2. Armazenamento de Imagens (Azure Blob Storage Connection String) ──
# String de conexão obtida no separador 'Access keys' da sua Storage Account do Azure
BLOB_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=cityguardsstore;AccountKey=xxxx==;EndpointSuffix=core.windows.net"


# ── 3. Serviços de Inteligência Artificial (Azure AI Vision) ───────────
# Endpoint do serviço de visão cognitiva do Azure (Computer Vision)
AI_VISION_ENDPOINT=https://cityguards-vision.cognitiveservices.azure.com/

# Chave de subscrição primária do serviço Computer Vision
AI_VISION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── 4. Outras Variáveis Locais (Opcional) ──────────────────────────────
# URL base para chamadas de API internas no Next.js (por padrão assume http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
